---
import { getCollection } from "astro:content";
import Default from "@/layouts/Default.astro";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blog"))
    .filter((post) => post.data.status === "released")
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return paginate(posts, { pageSize: 20 });
}

const { page } = Astro.props;

const formatDate = (value: Date) => new Date(value).toISOString().slice(0, 10);
const postPath = (post) => {
  const [year, month, ...rest] = post.id.split("/");
  const slug = rest.join("/").replace(/\.md$/, "");
  return `/blog/${year}/${month}/${slug}`;
};
---

<Default title="Blog" description="A chronological collection of posts and notes.">
  <h1>Blog</h1>

  <ul class="post-list">
    {page.data.map((post) => (
      <li class="post-item">
        <a href={postPath(post)} class="post-title">{post.data.title}</a>
        <div class="meta-row">
          <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {post.data.tags && post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>

  {page.total > 1 && (
    <nav class="pagination" aria-label="Blog pagination">
      {page.url.prev ? <a href={page.url.prev}>Previous</a> : <span>Previous</span>}
      <span>Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next}>Next</a> : <span>Next</span>}
    </nav>
  )}
</Default>

<style>
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .post-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .post-title {
    display: inline-block;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  time {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .tag-list {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.5rem;
    border-radius: var(--border-radius);
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.75rem;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .meta-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
