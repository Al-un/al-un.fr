---
import { getCollection } from "astro:content";
import Default from "@/layouts/Default.astro";

const books = await getCollection("writing-books");
---

<Default title="Writing" description="Long-form notes and essays.">
  <h1>Writing</h1>

  <div class="book-list">
    {books.map((book) => (
      <article class="book-card">
        <div class="card-header">
          <h2><a href={`/writing/${book.id.split("/")[0]}`}>{book.data.title}</a></h2>
          <span class="status-badge">{book.data.status}</span>
        </div>
        <p>{book.data.description}</p>
      </article>
    ))}
  </div>
</Default>

<style>
  .book-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .book-card {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-card-bg);
    padding: 1rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
</style>
