---
import Default from "@/layouts/Default.astro";
---

<Default title="Not Found" description="Page not found.">
  <div class="not-found">
    <h1>404</h1>
    <p>This page doesn’t exist.</p>
    <a href="/">Go home</a>
  </div>
</Default>

<style>
  .not-found {
    min-height: 50vh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  h1 {
    font-size: 4rem;
    line-height: 1;
  }
</style>
