---
import { getCollection } from "astro:content";
import Default from "@/layouts/Default.astro";

const experience = await getCollection("experience");
const internalLinks = [
  { href: "/blog", title: "Blog", description: "Chronological notes on software work and ideas." },
  { href: "/games", title: "Games", description: "Self-contained experiments and playful prototypes." },
  { href: "/writing", title: "Writing", description: "Longer-form reads and study notes." },
  { href: "/karaoke", title: "Karaoke", description: "A quick reference list for song practice." },
];

const externalLinks = [
  { href: "https://github.com/Al-un", title: "GitHub", description: "Code, experiments, and public repos." },
  { href: "https://www.linkedin.com", title: "LinkedIn", description: "Professional profile and career history." },
];
---

<Default title="Home" description="Personal website and engineering notes.">
  <section id="welcome">
    <h1>Hi, I’m Al-un.</h1>
    <p>
      I’m a software engineer who likes building dependable systems, clear interfaces, and small experiments that still get used.
    </p>
  </section>

  <hr />

  <section id="experience">
    <h2>Work experience</h2>
    {experience.map((entry) => (
      <article class="company">
        <h3>{entry.data.company}</h3>
        <ul class="roles">
          {entry.data.roles.map((role) => (
            <li class="role-item">
              <span>{role.title}</span>
              <span class="role-period">{role.period}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <hr />

  <section id="presence">
    <h2>Internet presence</h2>

    <div class="presence-grid">
      <div>
        <h3>On this site</h3>
        <ul class="presence-list">
          {internalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.title}</a>
              <span>{link.description}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3>Elsewhere</h3>
        <ul class="presence-list">
          {externalLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer">{link.title}</a>
              <span>{link.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    Built with Astro, Vue, Render, and <a href="https://github.com/Al-un/al-un.fr">GitHub</a>.
  </Fragment>
</Default>

<style>
  #welcome {
    margin-bottom: 1rem;
  }

  #welcome h1 {
    margin-bottom: 0.75rem;
  }

  .company {
    margin-bottom: 1.5rem;
  }

  .roles {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .role-item {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .role-period {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .presence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .presence-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .presence-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .presence-list span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .presence-grid {
      grid-template-columns: 1fr;
    }

    .role-item {
      flex-direction: column;
    }
  }
</style>
