---
import ThemeSwitcher from "@/components/ThemeSwitcher.vue";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/games", label: "Games" },
  { href: "/writing", label: "Writing" },
  { href: "/karaoke", label: "Karaoke" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <nav class="nav">
    <a href="/" class="nav-brand">al-un.fr</a>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="nav-toggle" type="button">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <ul class="nav-links" id="nav-links">
      {navLinks.map((link) => {
        const active = link.href === "/" ? currentPath === "/" : currentPath.startsWith(link.href);
        return (
          <li>
            <a class:list={["nav-link", { active }]} href={link.href}>{link.label}</a>
          </li>
        );
      })}
    </ul>

    <ThemeSwitcher client:load />
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");

  const syncCompactState = () => {
    if (!header) return;
    header.dataset.compact = String(window.scrollY > window.innerHeight);
  };

  const syncToggleState = () => {
    if (!toggle || !links) return;
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    links.dataset.open = expanded ? "true" : "false";
  };

  toggle?.addEventListener("click", () => {
    const next = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(next));
    toggle.classList.toggle("open", next);
    syncToggleState();
  });

  document.addEventListener("scroll", syncCompactState, { passive: true });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 640 && toggle) {
      toggle.setAttribute("aria-expanded", "false");
      toggle.classList.remove("open");
      links?.setAttribute("data-open", "false");
    }
  });

  syncCompactState();
  syncToggleState();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: padding 0.2s ease;
  }

  .nav {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    transition: padding 0.2s ease, gap 0.2s ease;
  }

  .site-header[data-compact="true"] .nav {
    padding: 0.4rem 1rem;
    gap: 1rem;
  }

  .site-header[data-compact="true"] .nav-brand {
    font-size: 0.95rem;
  }

  .site-header[data-compact="true"] .nav-links {
    gap: 0.75rem;
  }

  .site-header[data-compact="true"] .nav-link {
    font-size: 0.8rem;
  }

  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-heading);
    transition: font-size 0.2s ease;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1rem;
    flex: 1;
    transition: gap 0.2s ease;
  }

  .nav-link {
    color: var(--color-muted);
    font-size: 0.9rem;
    transition: font-size 0.2s ease;
  }

  .nav-link.active {
    color: var(--color-text);
    font-weight: 600;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0.35rem;
    margin-left: auto;
  }

  .nav-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle-bar + .nav-toggle-bar {
    margin-top: 5px;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav {
      padding: 0.3rem 0.75rem;
    }

    .nav-toggle {
      display: flex;
      flex-direction: column;
    }

    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.5rem 0;
    }

    .nav-links[data-open="true"] {
      display: flex;
    }

    .nav-link {
      display: block;
      padding: 0.4rem 0;
    }
  }
</style>
